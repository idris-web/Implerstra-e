---
import { translations } from '../i18n/translations';

interface Props {
  lang: keyof typeof translations;
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background with gradient -->
  <div class="absolute inset-0 gradient-bg"></div>

  <!-- Islamic Pattern Overlay -->
  <div class="absolute inset-0 islamic-pattern opacity-30"></div>

  <!-- Decorative Elements -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-kosovo-gold/20 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>

  <!-- Stars decoration (Kosovo flag inspired) -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 left-1/4 text-kosovo-gold text-4xl opacity-20">★</div>
    <div class="absolute top-1/3 right-1/3 text-kosovo-gold text-3xl opacity-15">★</div>
    <div class="absolute bottom-1/3 left-1/3 text-kosovo-gold text-5xl opacity-20">★</div>
    <div class="absolute top-1/2 right-1/4 text-kosovo-gold text-3xl opacity-15">★</div>
    <div class="absolute bottom-1/4 right-1/2 text-kosovo-gold text-4xl opacity-20">★</div>
    <div class="absolute top-2/3 left-1/5 text-kosovo-gold text-3xl opacity-15">★</div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 text-center">
    <!-- Mosque Icon -->
    <div class="mb-8 inline-block">
      <div class="w-24 h-24 mx-auto bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center border border-white/20">
        <svg class="w-14 h-14 text-kosovo-gold" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C12 2 8 6 8 10C8 11.1 8.45 12.1 9.17 12.83L7 15H6V22H18V15H17L14.83 12.83C15.55 12.1 16 11.1 16 10C16 6 12 2 12 2ZM12 4.5C12 4.5 14 7 14 10C14 11.1 13.1 12 12 12C10.9 12 10 11.1 10 10C10 7 12 4.5 12 4.5ZM8 17H16V20H8V17Z"/>
        </svg>
      </div>
    </div>

    <!-- Title -->
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-4 tracking-tight">
      {t.hero.title}
    </h1>

    <!-- Subtitle -->
    <p class="text-xl md:text-2xl lg:text-3xl text-kosovo-gold font-medium mb-6">
      {t.hero.subtitle}
    </p>

    <!-- Description -->
    <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto mb-10">
      {t.hero.description}
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="#donate" class="btn-primary text-lg px-10 py-4 inline-flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
        </svg>
        {t.hero.cta}
      </a>
      <a href="#about" class="btn-outline border-white text-white hover:bg-white hover:text-kosovo-blue text-lg px-10 py-4 inline-flex items-center gap-2">
        {t.hero.learnMore}
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
    <svg class="w-8 h-8 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
