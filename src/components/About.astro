---
import { translations } from '../i18n/translations';

interface Props {
  lang: keyof typeof translations;
}

const { lang } = Astro.props;
const t = translations[lang];

const values = [
  { icon: '🕌', title: t.about.value1 },
  { icon: '🤝', title: t.about.value2 },
  { icon: '📖', title: t.about.value3 },
  { icon: '🏛️', title: t.about.value4 },
];
---

<section id="about" class="py-20 md:py-32 bg-white relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-kosovo-blue/5 to-transparent"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-kosovo-gold/10 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 bg-kosovo-blue/10 text-kosovo-blue text-sm font-semibold rounded-full mb-4">
        {t.about.subtitle}
      </span>
      <h2 class="section-title">{t.about.title}</h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Left: Image/Visual -->
      <div class="relative">
        <div class="aspect-square bg-gradient-to-br from-kosovo-blue to-kosovo-blue-dark rounded-3xl overflow-hidden shadow-2xl">
          <!-- Placeholder for mosque image -->
          <div class="w-full h-full flex items-center justify-center islamic-pattern">
            <div class="text-center p-8">
              <div class="w-32 h-32 mx-auto bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center mb-6">
                <svg class="w-20 h-20 text-kosovo-gold" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C12 2 8 6 8 10C8 11.1 8.45 12.1 9.17 12.83L7 15H6V22H18V15H17L14.83 12.83C15.55 12.1 16 11.1 16 10C16 6 12 2 12 2ZM12 4.5C12 4.5 14 7 14 10C14 11.1 13.1 12 12 12C10.9 12 10 11.1 10 10C10 7 12 4.5 12 4.5ZM8 17H16V20H8V17Z"/>
                </svg>
              </div>
              <p class="text-white/80 text-lg font-medium">Est. 2014</p>
              <p class="text-kosovo-gold text-xl font-bold">München</p>
            </div>
          </div>
        </div>

        <!-- Floating badge -->
        <div class="absolute -bottom-6 -right-6 bg-kosovo-gold text-white p-6 rounded-2xl shadow-xl">
          <div class="text-4xl font-bold">10+</div>
          <div class="text-sm opacity-90">Jahre</div>
        </div>
      </div>

      <!-- Right: Content -->
      <div>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">
          {t.about.description}
        </p>

        <!-- Mission -->
        <div class="bg-gradient-to-r from-kosovo-blue/5 to-transparent p-6 rounded-2xl mb-8 border-l-4 border-kosovo-blue">
          <h3 class="text-xl font-bold text-kosovo-blue mb-3">{t.about.mission}</h3>
          <p class="text-gray-600">{t.about.missionText}</p>
        </div>

        <!-- Values -->
        <h3 class="text-xl font-bold text-kosovo-blue mb-6">{t.about.values}</h3>
        <div class="grid grid-cols-2 gap-4">
          {values.map((value) => (
            <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl hover:bg-kosovo-gold/10 transition-colors group">
              <span class="text-2xl group-hover:scale-110 transition-transform">{value.icon}</span>
              <span class="font-medium text-gray-700">{value.title}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
