<style>
  .team-tab-btn {
    @apply bg-gray-100 text-gray-600;
  }
  .team-tab-btn:hover {
    @apply bg-gray-200;
  }
  .team-tab-btn.active {
    @apply bg-gradient-to-r from-kosovo-blue to-kosovo-blue-dark text-white shadow-lg;
  }

  .team-category {
    @apply transition-all duration-500;
  }
  .team-category.hidden {
    @apply hidden;
  }
</style>

<script>
  // Team category tabs
  document.querySelectorAll('.team-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category');

      // Update active tab
      document.querySelectorAll('.team-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Show/hide categories
      document.querySelectorAll('.team-category').forEach(cat => {
        cat.classList.add('hidden');
      });

      const targetCategory = document.getElementById(`team-${category}`);
      if (targetCategory) {
        targetCategory.classList.remove('hidden');

        // Re-trigger scroll animations
        targetCategory.querySelectorAll('.scroll-animate').forEach(el => {
          el.classList.remove('visible');
          setTimeout(() => {
            el.classList.add('visible');
          }, 50);
        });
      }
    });
  });

  // Initial animation trigger
  setTimeout(() => {
    document.querySelectorAll('#team-leadership .scroll-animate').forEach(el => {
      el.classList.add('visible');
    });
  }, 100);
</script>
