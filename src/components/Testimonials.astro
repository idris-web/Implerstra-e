---
import { translations } from '../i18n/translations';

interface Props {
  lang: keyof typeof translations;
}

const { lang } = Astro.props;

const testimonials = [
  {
    id: 1,
    name: 'Fatmir Krasniqi',
    role: lang === 'de' ? 'Gemeindemitglied seit 2015' : lang === 'sq' ? 'Anëtar i bashkësisë që nga 2015' : 'عضو منذ 2015',
    content: lang === 'de'
      ? 'Die Moschee Kosova e.V. ist mehr als nur ein Gebetsort. Es ist unser zweites Zuhause, wo wir unsere Kultur pflegen und unsere Kinder in einem islamischen Umfeld aufwachsen sehen können.'
      : lang === 'sq'
      ? 'Xhamia Kosova e.V. është më shumë se vetëm një vend për namaz. Është shtëpia jonë e dytë, ku ruajmë kulturën tonë dhe shohim fëmijët tanë të rriten në një mjedis islam.'
      : 'مسجد كوسوفا هو أكثر من مجرد مكان للصلاة. إنه بيتنا الثاني، حيث نحافظ على ثقافتنا ونرى أطفالنا ينمون في بيئة إسلامية.',
    image: null,
    rating: 5,
  },
  {
    id: 2,
    name: 'Lirije Berisha',
    role: lang === 'de' ? 'Mutter von 3 Kindern' : lang === 'sq' ? 'Nënë e 3 fëmijëve' : 'أم لـ 3 أطفال',
    content: lang === 'de'
      ? 'Meine Kinder lieben den Koranunterricht hier. Die Lehrer sind geduldig und engagiert. Es ist wunderbar zu sehen, wie sie den Quran lernen und gleichzeitig ihre albanische Identität bewahren.'
      : lang === 'sq'
      ? 'Fëmijët e mi e duan mësimin e Kuranit këtu. Mësuesit janë të duruar dhe të përkushtuar. Është e mrekullueshme të shohësh si mësojnë Kuranin dhe ruajnë identitetin shqiptar.'
      : 'أطفالي يحبون دروس القرآن هنا. المعلمون صبورون ومتفانون. من الرائع رؤيتهم يتعلمون القرآن ويحافظون على هويتهم.',
    image: null,
    rating: 5,
  },
  {
    id: 3,
    name: 'Besnik Gashi',
    role: lang === 'de' ? 'Jugendlicher, 17 Jahre' : lang === 'sq' ? 'I ri, 17 vjeç' : 'شاب، 17 سنة',
    content: lang === 'de'
      ? 'Als Jugendlicher finde ich hier eine Gemeinschaft, die mich versteht. Die Jugendprogramme sind toll und ich habe viele Freunde gefunden, die die gleichen Werte teilen.'
      : lang === 'sq'
      ? 'Si i ri, gjej këtu një bashkësi që më kupton. Programet rinore janë të shkëlqyera dhe kam gjetur shumë miq që ndajnë të njëjtat vlera.'
      : 'كشاب، أجد هنا مجتمعاً يفهمني. برامج الشباب رائعة ووجدت العديد من الأصدقاء الذين يشاركونني نفس القيم.',
    image: null,
    rating: 5,
  },
  {
    id: 4,
    name: 'Shpresa Hoxha',
    role: lang === 'de' ? 'Neue Münchnerin' : lang === 'sq' ? 'E re në Mynih' : 'جديدة في ميونخ',
    content: lang === 'de'
      ? 'Als ich nach München gezogen bin, war die Moschee meine erste Anlaufstelle. Die Gemeinde hat mich mit offenen Armen empfangen. Jetzt fühle ich mich hier zu Hause.'
      : lang === 'sq'
      ? 'Kur u transferova në Mynih, xhamia ishte pika ime e parë e kontaktit. Bashkësia më priti me krahë të hapur. Tani ndihem si në shtëpi këtu.'
      : 'عندما انتقلت إلى ميونخ، كان المسجد أول مكان ألجأ إليه. استقبلني المجتمع بأذرع مفتوحة. الآن أشعر وكأنني في بيتي.',
    image: null,
    rating: 5,
  },
];

const stats = [
  { value: '98%', label: lang === 'de' ? 'Zufriedene Mitglieder' : lang === 'sq' ? 'Anëtarë të kënaqur' : 'أعضاء راضون' },
  { value: '4.9', label: lang === 'de' ? 'Durchschnittliche Bewertung' : lang === 'sq' ? 'Vlerësimi mesatar' : 'التقييم المتوسط' },
  { value: '500+', label: lang === 'de' ? 'Aktive Familien' : lang === 'sq' ? 'Familje aktive' : 'عائلات نشطة' },
];
---

<section id="testimonials" class="section-padding bg-gradient-to-b from-gray-50 to-white relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 left-0 w-1/3 h-full bg-gradient-to-r from-kosovo-blue/5 to-transparent pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-1/3 h-full bg-gradient-to-l from-kosovo-gold/5 to-transparent pointer-events-none"></div>

  <!-- Large quote marks -->
  <div class="absolute top-20 left-10 text-kosovo-blue/5 text-[200px] font-serif leading-none pointer-events-none">"</div>
  <div class="absolute bottom-20 right-10 text-kosovo-gold/5 text-[200px] font-serif leading-none pointer-events-none rotate-180">"</div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="badge-gold mb-4">
        <span>💬</span>
        <span>{lang === 'de' ? 'Erfahrungen' : lang === 'sq' ? 'Përvojat' : 'تجارب'}</span>
      </span>
      <h2 class="section-title">
        {lang === 'de' ? 'Stimmen unserer Gemeinde' : lang === 'sq' ? 'Zërat e bashkësisë sonë' : 'أصوات مجتمعنا'}
      </h2>
      <p class="section-subtitle">
        {lang === 'de' ? 'Was unsere Mitglieder über uns sagen' : lang === 'sq' ? 'Çfarë thonë anëtarët tanë për ne' : 'ماذا يقول أعضاؤنا عنا'}
      </p>
    </div>

    <!-- Stats Bar -->
    <div class="flex flex-wrap justify-center gap-8 md:gap-16 mb-16">
      {stats.map((stat) => (
        <div class="text-center">
          <div class="text-4xl md:text-5xl font-black text-kosovo-blue mb-2">{stat.value}</div>
          <div class="text-gray-600">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Testimonials Grid -->
    <div class="grid md:grid-cols-2 gap-8">
      {testimonials.map((testimonial, index) => (
        <div class={`group card hover:border-kosovo-gold/20 ${index === 0 ? 'md:col-span-2' : ''}`}>
          <div class={`${index === 0 ? 'md:flex md:gap-8 md:items-start' : ''}`}>
            {/* Avatar */}
            <div class={`mb-6 ${index === 0 ? 'md:mb-0' : ''}`}>
              <div class={`${index === 0 ? 'w-24 h-24' : 'w-16 h-16'} bg-gradient-to-br from-kosovo-blue to-kosovo-blue-dark rounded-2xl flex items-center justify-center text-white shadow-lg group-hover:scale-105 transition-transform`}>
                <svg class={`${index === 0 ? 'w-12 h-12' : 'w-8 h-8'}`} fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              </div>
            </div>

            {/* Content */}
            <div class="flex-1">
              {/* Rating */}
              <div class="flex gap-1 mb-4">
                {Array.from({ length: testimonial.rating }).map((_, i) => (
                  <svg class="w-5 h-5 text-kosovo-gold" fill="currentColor" viewBox="0 0 24 24">
                    <polygon points="12,2 15,9 22,9 17,14 19,22 12,17 5,22 7,14 2,9 9,9"/>
                  </svg>
                ))}
              </div>

              {/* Quote */}
              <p class={`text-gray-600 leading-relaxed mb-6 ${index === 0 ? 'text-lg' : ''}`}>
                "{testimonial.content}"
              </p>

              {/* Author */}
              <div class="flex items-center gap-4">
                <div>
                  <h4 class="font-bold text-gray-800">{testimonial.name}</h4>
                  <p class="text-sm text-gray-500">{testimonial.role}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <div class="inline-flex flex-col sm:flex-row gap-4 items-center p-6 bg-white rounded-2xl shadow-xl border border-gray-100">
        <div class="text-left">
          <h4 class="font-bold text-gray-800">
            {lang === 'de' ? 'Teil unserer Gemeinschaft werden?' : lang === 'sq' ? 'Dëshironi të bëheni pjesë e bashkësisë?' : 'تريد أن تكون جزءاً من مجتمعنا؟'}
          </h4>
          <p class="text-sm text-gray-500">
            {lang === 'de' ? 'Besuchen Sie uns bei einem unserer Gebete oder Veranstaltungen.' : lang === 'sq' ? 'Na vizitoni në një nga namazet ose ngjarjet tona.' : 'زورونا في إحدى صلواتنا أو فعالياتنا.'}
          </p>
        </div>
        <a href="#contact" class="btn-secondary whitespace-nowrap">
          {lang === 'de' ? 'Kontakt' : lang === 'sq' ? 'Kontakt' : 'اتصل بنا'}
        </a>
      </div>
    </div>
  </div>
</section>
