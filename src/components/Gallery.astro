---
import { translations } from '../i18n/translations';

interface Props {
  lang: keyof typeof translations;
}

const { lang } = Astro.props;
const t = translations[lang];

// Placeholder images with different aspect ratios
const galleryItems = [
  { id: 1, label: 'Moschee Außen', aspect: 'aspect-square', span: 'md:col-span-2 md:row-span-2' },
  { id: 2, label: 'Gebetsraum', aspect: 'aspect-square', span: '' },
  { id: 3, label: 'Koranunterricht', aspect: 'aspect-square', span: '' },
  { id: 4, label: 'Gemeinde', aspect: 'aspect-video', span: 'md:col-span-2' },
  { id: 5, label: 'Freitagsgebet', aspect: 'aspect-square', span: '' },
  { id: 6, label: 'Veranstaltung', aspect: 'aspect-square', span: '' },
];
---

<section id="gallery" class="py-20 md:py-32 bg-gradient-to-br from-gray-50 to-gray-100 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 bg-kosovo-gold/10 text-kosovo-gold-dark text-sm font-semibold rounded-full mb-4">
        📷 {t.gallery.subtitle}
      </span>
      <h2 class="section-title">{t.gallery.title}</h2>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {galleryItems.map((item) => (
        <div class={`${item.span} group cursor-pointer`}>
          <div class={`${item.aspect} bg-gradient-to-br from-kosovo-blue to-kosovo-blue-dark rounded-2xl overflow-hidden relative shadow-lg hover:shadow-2xl transition-all duration-300 group-hover:scale-[1.02]`}>
            <!-- Placeholder pattern -->
            <div class="absolute inset-0 islamic-pattern opacity-20"></div>

            <!-- Placeholder content -->
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center text-white p-4">
                <svg class="w-12 h-12 mx-auto mb-2 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span class="text-sm opacity-70">{item.label}</span>
              </div>
            </div>

            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-kosovo-gold/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <div class="text-white text-center">
                <svg class="w-10 h-10 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                </svg>
                <span class="text-sm font-medium">{item.label}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Note for admin -->
    <p class="text-center text-gray-500 text-sm mt-8 italic">
      {lang === 'de' ? '* Bilder werden bald hinzugefügt' : lang === 'sq' ? '* Fotografitë do të shtohen së shpejti' : '* ستضاف الصور قريباً'}
    </p>
  </div>
</section>
