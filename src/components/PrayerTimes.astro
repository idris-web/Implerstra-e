---
import { translations } from '../i18n/translations';

interface Props {
  lang: keyof typeof translations;
}

const { lang } = Astro.props;
const t = translations[lang];

// Example prayer times (these would ideally come from an API)
const prayerTimes = [
  { name: t.prayer.fajr, time: '06:15', icon: '🌅' },
  { name: t.prayer.sunrise, time: '07:45', icon: '☀️' },
  { name: t.prayer.dhuhr, time: '12:30', icon: '🌤️' },
  { name: t.prayer.asr, time: '15:00', icon: '⛅' },
  { name: t.prayer.maghrib, time: '17:15', icon: '🌅' },
  { name: t.prayer.isha, time: '18:45', icon: '🌙' },
];
---

<section id="prayer-times" class="py-20 md:py-32 bg-gradient-to-br from-gray-50 to-white relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-white to-transparent"></div>
  <div class="absolute -top-20 -right-20 w-80 h-80 bg-kosovo-gold/10 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 bg-kosovo-gold/10 text-kosovo-gold-dark text-sm font-semibold rounded-full mb-4">
        🕌 {t.prayer.subtitle}
      </span>
      <h2 class="section-title">{t.prayer.title}</h2>
    </div>

    <!-- Prayer Times Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-12">
      {prayerTimes.map((prayer) => (
        <div class="card text-center group hover:bg-kosovo-blue hover:text-white">
          <div class="text-3xl mb-3 group-hover:scale-125 transition-transform">{prayer.icon}</div>
          <h3 class="font-semibold text-gray-700 group-hover:text-white mb-2">{prayer.name}</h3>
          <p class="text-2xl font-bold text-kosovo-blue group-hover:text-kosovo-gold">{prayer.time}</p>
        </div>
      ))}
    </div>

    <!-- Jummah Prayer Highlight -->
    <div class="max-w-2xl mx-auto">
      <div class="bg-gradient-to-r from-kosovo-blue to-kosovo-blue-dark rounded-3xl p-8 text-center text-white shadow-2xl relative overflow-hidden">
        <!-- Pattern overlay -->
        <div class="absolute inset-0 islamic-pattern opacity-10"></div>

        <div class="relative z-10">
          <div class="inline-block p-4 bg-white/10 rounded-2xl mb-4">
            <svg class="w-12 h-12 text-kosovo-gold" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C12 2 8 6 8 10C8 11.1 8.45 12.1 9.17 12.83L7 15H6V22H18V15H17L14.83 12.83C15.55 12.1 16 11.1 16 10C16 6 12 2 12 2ZM12 4.5C12 4.5 14 7 14 10C14 11.1 13.1 12 12 12C10.9 12 10 11.1 10 10C10 7 12 4.5 12 4.5ZM8 17H16V20H8V17Z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-2">{t.prayer.jummah}</h3>
          <p class="text-4xl font-bold text-kosovo-gold">{t.prayer.jummahTime}</p>
        </div>
      </div>
    </div>

    <!-- Note -->
    <p class="text-center text-gray-500 text-sm mt-8">
      * Die Gebetszeiten werden regelmäßig aktualisiert
    </p>
  </div>
</section>
