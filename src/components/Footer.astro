---
import { translations } from '../i18n/translations';

interface Props {
  lang: keyof typeof translations;
}

const { lang } = Astro.props;
const t = translations[lang];

const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: '#home', label: t.nav.home },
  { href: '#about', label: t.nav.about },
  { href: '#prayer-times', label: t.nav.prayerTimes },
  { href: '#events', label: t.nav.events },
  { href: '#donate', label: t.nav.donate },
  { href: '#contact', label: t.nav.contact },
];
---

<footer class="bg-gray-900 text-white relative overflow-hidden">
  <!-- Pattern overlay -->
  <div class="absolute inset-0 islamic-pattern opacity-5"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Main Footer -->
    <div class="py-16 grid md:grid-cols-3 gap-12">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-14 h-14 bg-gradient-to-br from-kosovo-blue to-kosovo-blue-dark rounded-full flex items-center justify-center shadow-lg">
            <span class="text-white font-bold text-2xl">K</span>
          </div>
          <div>
            <span class="text-white font-bold text-xl block">Kosova e.V.</span>
            <span class="text-gray-400 text-sm">München • seit 2014</span>
          </div>
        </div>
        <p class="text-gray-400 leading-relaxed">
          {lang === 'de'
            ? 'Die albanische Moschee in München - ein Ort des Glaubens, der Gemeinschaft und der Bildung.'
            : lang === 'sq'
            ? 'Xhamia shqiptare në Mynih - një vend i besimit, bashkësisë dhe arsimit.'
            : 'المسجد الألباني في ميونخ - مكان للإيمان والمجتمع والتعليم.'}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-6 text-kosovo-gold">
          {lang === 'de' ? 'Schnellzugriff' : lang === 'sq' ? 'Lidhje të shpejta' : 'روابط سريعة'}
        </h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white hover:translate-x-1 inline-block transition-all duration-200">
                → {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-lg font-semibold mb-6 text-kosovo-gold">
          {t.nav.contact}
        </h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-kosovo-gold flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-gray-400">Musterstraße 123<br/>80333 München</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-kosovo-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span class="text-gray-400">+49 89 12345678</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-kosovo-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span class="text-gray-400">info@kosova-muenchen.de</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="py-6 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-500 text-sm">
        © {currentYear} Kosova e.V. {t.footer.rights}
      </p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-gray-500 hover:text-white text-sm transition-colors">{t.footer.imprint}</a>
        <a href="#" class="text-gray-500 hover:text-white text-sm transition-colors">{t.footer.privacy}</a>
      </div>
    </div>
  </div>

  <!-- Back to top button -->
  <button
    id="back-to-top"
    class="fixed bottom-8 right-8 w-12 h-12 bg-kosovo-gold hover:bg-kosovo-gold-dark text-white rounded-full shadow-lg flex items-center justify-center opacity-0 invisible transition-all duration-300 z-50"
    aria-label="Back to top"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
  </button>
</footer>

<script>
  // Back to top button
  const backToTop = document.getElementById('back-to-top');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 500) {
      backToTop?.classList.remove('opacity-0', 'invisible');
      backToTop?.classList.add('opacity-100', 'visible');
    } else {
      backToTop?.classList.add('opacity-0', 'invisible');
      backToTop?.classList.remove('opacity-100', 'visible');
    }
  });

  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
