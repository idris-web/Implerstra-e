---
import { translations } from '../i18n/translations';

interface Props {
  lang: keyof typeof translations;
}

const { lang } = Astro.props;
const t = translations[lang];

const currentYear = new Date().getFullYear();

// Navigation links
const quickLinks = [
  { href: '#home', label: t.nav.home },
  { href: '#about', label: t.nav.about },
  { href: '#prayer-times', label: t.nav.prayerTimes },
  { href: '#events', label: t.nav.events },
  { href: '#donate', label: t.nav.donate },
  { href: '#contact', label: t.nav.contact },
];

// Service links
const serviceLinks = {
  de: [
    { href: '#prayer-times', label: 'Gebetszeiten' },
    { href: '#events', label: 'Koranschule' },
    { href: '#events', label: 'Jugendprogramm' },
    { href: '#events', label: 'Frauenkreis' },
    { href: '#donate', label: 'Spenden' },
    { href: '#contact', label: 'Religiöse Beratung' },
  ],
  sq: [
    { href: '#prayer-times', label: 'Kohët e Namazit' },
    { href: '#events', label: 'Shkolla e Kuranit' },
    { href: '#events', label: 'Programi i Rinisë' },
    { href: '#events', label: 'Rrethi i Grave' },
    { href: '#donate', label: 'Donacionet' },
    { href: '#contact', label: 'Këshillim Fetar' },
  ],
  ar: [
    { href: '#prayer-times', label: 'أوقات الصلاة' },
    { href: '#events', label: 'مدرسة القرآن' },
    { href: '#events', label: 'برنامج الشباب' },
    { href: '#events', label: 'حلقة النساء' },
    { href: '#donate', label: 'التبرعات' },
    { href: '#contact', label: 'الإرشاد الديني' },
  ]
};

// Resource links
const resourceLinks = {
  de: [
    { href: '#faq', label: 'Häufige Fragen' },
    { href: '#gallery', label: 'Galerie' },
    { href: '#news', label: 'Neuigkeiten' },
    { href: '#team', label: 'Unser Team' },
    { href: '#', label: 'Mitglied werden' },
    { href: '#', label: 'Ehrenamt' },
  ],
  sq: [
    { href: '#faq', label: 'Pyetjet e shpeshta' },
    { href: '#gallery', label: 'Galeria' },
    { href: '#news', label: 'Lajmet' },
    { href: '#team', label: 'Ekipi ynë' },
    { href: '#', label: 'Bëhu anëtar' },
    { href: '#', label: 'Vullnetarizëm' },
  ],
  ar: [
    { href: '#faq', label: 'الأسئلة الشائعة' },
    { href: '#gallery', label: 'المعرض' },
    { href: '#news', label: 'الأخبار' },
    { href: '#team', label: 'فريقنا' },
    { href: '#', label: 'كن عضواً' },
    { href: '#', label: 'التطوع' },
  ]
};

// Social media
const socialMedia = [
  { name: 'Facebook', icon: 'facebook', url: 'https://facebook.com/kosovaev', color: '#1877F2' },
  { name: 'Instagram', icon: 'instagram', url: 'https://instagram.com/kosovaev', color: '#E4405F' },
  { name: 'YouTube', icon: 'youtube', url: 'https://youtube.com/kosovaev', color: '#FF0000' },
  { name: 'WhatsApp', icon: 'whatsapp', url: 'https://wa.me/4917612345678', color: '#25D366' },
  { name: 'TikTok', icon: 'tiktok', url: 'https://tiktok.com/@kosovaev', color: '#000000' }
];

// Contact info
const contactInfo = {
  address: 'Musterstraße 123, 80333 München',
  phone: '+49 89 12345678',
  email: 'info@kosova-muenchen.de',
  whatsapp: '+49 176 12345678'
};

// Language options
const languages = [
  { code: 'de', label: 'Deutsch', flag: '🇩🇪', href: '/' },
  { code: 'sq', label: 'Shqip', flag: '🇦🇱', href: '/sq/' },
  { code: 'ar', label: 'العربية', flag: '🇸🇦', href: '/ar/' }
];
---

<footer class="bg-gray-900 text-white relative overflow-hidden">
  <!-- Pattern overlay -->
  <div class="absolute inset-0 islamic-pattern opacity-5"></div>

  <!-- Decorative shapes -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-kosovo-blue/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-kosovo-gold/5 rounded-full blur-3xl translate-x-1/4 translate-y-1/4"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Newsletter Section -->
    <div class="py-12 border-b border-gray-800">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-kosovo-gold/20 rounded-full text-kosovo-gold text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          <span>{lang === 'de' ? 'Newsletter' : lang === 'sq' ? 'Buletini' : 'النشرة الإخبارية'}</span>
        </div>
        <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">
          {lang === 'de' ? 'Bleiben Sie auf dem Laufenden' :
           lang === 'sq' ? 'Qëndroni të informuar' :
           'ابق على اطلاع'}
        </h3>
        <p class="text-gray-400 mb-8 max-w-xl mx-auto">
          {lang === 'de' ? 'Erhalten Sie wöchentliche Updates zu Veranstaltungen, Gebetszeiten und Neuigkeiten aus unserer Gemeinde.' :
           lang === 'sq' ? 'Merrni përditësime javore për evenimentet, kohët e namazit dhe lajmet nga komuniteti ynë.' :
           'احصل على تحديثات أسبوعية عن الفعاليات وأوقات الصلاة وأخبار مجتمعنا.'}
        </p>

        <form id="newsletter-form" class="flex flex-col sm:flex-row gap-4 max-w-lg mx-auto">
          <div class="flex-grow relative">
            <input
              type="email"
              name="email"
              required
              class="w-full px-5 py-4 bg-gray-800 border border-gray-700 rounded-xl text-white placeholder-gray-500 focus:border-kosovo-gold focus:outline-none transition-colors"
              placeholder={lang === 'de' ? 'Ihre E-Mail-Adresse' : lang === 'sq' ? 'Adresa juaj e emailit' : 'بريدك الإلكتروني'}
            />
          </div>
          <button
            type="submit"
            class="px-8 py-4 bg-gradient-to-r from-kosovo-gold to-kosovo-gold-dark text-white font-semibold rounded-xl hover:shadow-lg hover:shadow-kosovo-gold/30 transition-all duration-300 flex items-center justify-center gap-2 whitespace-nowrap"
          >
            <span>{lang === 'de' ? 'Abonnieren' : lang === 'sq' ? 'Abonohu' : 'اشترك'}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </form>

        <p class="text-gray-500 text-sm mt-4">
          {lang === 'de' ? 'Kein Spam. Jederzeit abmelden.' :
           lang === 'sq' ? 'Pa spam. Çabonohuni në çdo kohë.' :
           'لا بريد مزعج. يمكنك إلغاء الاشتراك في أي وقت.'}
        </p>
      </div>
    </div>

    <!-- Main Footer -->
    <div class="py-16 grid md:grid-cols-2 lg:grid-cols-5 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-kosovo-blue to-kosovo-blue-dark rounded-2xl flex items-center justify-center shadow-lg shadow-kosovo-blue/30">
            <span class="text-white font-bold text-2xl">K</span>
          </div>
          <div>
            <span class="text-white font-bold text-2xl block">Kosova e.V.</span>
            <span class="text-gray-400 text-sm">München • {lang === 'de' ? 'Seit 2014' : lang === 'sq' ? 'Që nga 2014' : 'منذ 2014'}</span>
          </div>
        </div>
        <p class="text-gray-400 leading-relaxed mb-6 max-w-md">
          {lang === 'de'
            ? 'Die albanische Moschee in München - ein Ort des Glaubens, der Gemeinschaft und der Bildung. Wir heißen jeden willkommen, der mehr über den Islam erfahren möchte.'
            : lang === 'sq'
            ? 'Xhamia shqiptare në Mynih - një vend i besimit, bashkësisë dhe arsimit. Mirëpresim secilin që dëshiron të mësojë më shumë rreth Islamit.'
            : 'المسجد الألباني في ميونخ - مكان للإيمان والمجتمع والتعليم. نرحب بكل من يريد معرفة المزيد عن الإسلام.'}
        </p>

        <!-- Social Media -->
        <div class="flex gap-3">
          {socialMedia.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 bg-gray-800 hover:bg-gray-700 rounded-xl flex items-center justify-center transition-all duration-300 group"
              title={social.name}
            >
              {social.icon === 'facebook' && (
                <svg class="w-5 h-5 text-gray-400 group-hover:text-[#1877F2] transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              )}
              {social.icon === 'instagram' && (
                <svg class="w-5 h-5 text-gray-400 group-hover:text-[#E4405F] transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              )}
              {social.icon === 'youtube' && (
                <svg class="w-5 h-5 text-gray-400 group-hover:text-[#FF0000] transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              )}
              {social.icon === 'whatsapp' && (
                <svg class="w-5 h-5 text-gray-400 group-hover:text-[#25D366] transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              )}
              {social.icon === 'tiktok' && (
                <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-lg font-semibold mb-6 text-kosovo-gold">
          {lang === 'de' ? 'Dienste' : lang === 'sq' ? 'Shërbimet' : 'الخدمات'}
        </h3>
        <ul class="space-y-3">
          {serviceLinks[lang].map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white flex items-center gap-2 group transition-all duration-200">
                <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
                </svg>
                <span class="group-hover:translate-x-1 transition-transform">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-lg font-semibold mb-6 text-kosovo-gold">
          {lang === 'de' ? 'Ressourcen' : lang === 'sq' ? 'Burimet' : 'الموارد'}
        </h3>
        <ul class="space-y-3">
          {resourceLinks[lang].map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white flex items-center gap-2 group transition-all duration-200">
                <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
                </svg>
                <span class="group-hover:translate-x-1 transition-transform">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-lg font-semibold mb-6 text-kosovo-gold">
          {t.nav.contact}
        </h3>
        <ul class="space-y-4">
          <li>
            <a href={`https://maps.google.com/?q=${encodeURIComponent(contactInfo.address)}`} target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 text-gray-400 hover:text-white transition-colors group">
              <svg class="w-5 h-5 text-kosovo-gold flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span class="group-hover:underline">Musterstraße 123<br/>80333 München</span>
            </a>
          </li>
          <li>
            <a href={`tel:${contactInfo.phone.replace(/\s/g, '')}`} class="flex items-center gap-3 text-gray-400 hover:text-white transition-colors group">
              <svg class="w-5 h-5 text-kosovo-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span class="group-hover:underline">{contactInfo.phone}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${contactInfo.email}`} class="flex items-center gap-3 text-gray-400 hover:text-white transition-colors group">
              <svg class="w-5 h-5 text-kosovo-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <span class="group-hover:underline">{contactInfo.email}</span>
            </a>
          </li>
          <li>
            <a href={`https://wa.me/${contactInfo.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-gray-400 hover:text-white transition-colors group">
              <svg class="w-5 h-5 text-kosovo-gold flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              </svg>
              <span class="group-hover:underline">WhatsApp</span>
            </a>
          </li>
        </ul>

        <!-- Opening Hours Mini -->
        <div class="mt-6 p-4 bg-gray-800/50 rounded-xl">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-4 h-4 text-kosovo-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-sm font-medium text-white">
              {lang === 'de' ? 'Öffnungszeiten' : lang === 'sq' ? 'Orari' : 'ساعات العمل'}
            </span>
          </div>
          <p class="text-gray-400 text-sm">
            {lang === 'de' ? 'Mo-Do: 09:00-21:00' : lang === 'sq' ? 'Hë-En: 09:00-21:00' : 'الإثنين-الخميس: 09:00-21:00'}<br/>
            {lang === 'de' ? 'Fr: 09:00-22:00' : lang === 'sq' ? 'Pre: 09:00-22:00' : 'الجمعة: 09:00-22:00'}
          </p>
        </div>
      </div>
    </div>

    <!-- Language Switcher & Bottom Bar -->
    <div class="py-8 border-t border-gray-800">
      <!-- Language Switcher -->
      <div class="flex flex-wrap justify-center gap-4 mb-8">
        {languages.map((language) => (
          <a
            href={language.href}
            class={`flex items-center gap-2 px-4 py-2 rounded-lg transition-all duration-200 ${
              lang === language.code
                ? 'bg-kosovo-gold/20 text-kosovo-gold border border-kosovo-gold/30'
                : 'bg-gray-800 text-gray-400 hover:bg-gray-700 hover:text-white border border-gray-700'
            }`}
          >
            <span class="text-lg">{language.flag}</span>
            <span class="text-sm font-medium">{language.label}</span>
          </a>
        ))}
      </div>

      <!-- Bottom Links -->
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-gray-500 text-sm">
          © {currentYear} Kosova e.V. {t.footer.rights}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          <a href="#" class="text-gray-500 hover:text-white text-sm transition-colors">{t.footer.imprint}</a>
          <a href="#" class="text-gray-500 hover:text-white text-sm transition-colors">{t.footer.privacy}</a>
          <a href="#" class="text-gray-500 hover:text-white text-sm transition-colors">
            {lang === 'de' ? 'AGB' : lang === 'sq' ? 'Termat' : 'الشروط'}
          </a>
          <a href="#" class="text-gray-500 hover:text-white text-sm transition-colors">
            {lang === 'de' ? 'Satzung' : lang === 'sq' ? 'Statuti' : 'النظام الأساسي'}
          </a>
        </div>
      </div>

      <!-- Made with Love -->
      <div class="text-center mt-8">
        <p class="text-gray-600 text-sm flex items-center justify-center gap-2">
          {lang === 'de' ? 'Mit' : lang === 'sq' ? 'Me' : 'بـ'}
          <svg class="w-4 h-4 text-red-500 animate-pulse" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          {lang === 'de' ? 'in München erstellt' : lang === 'sq' ? 'krijuar në Mynih' : 'صنع في ميونخ'}
        </p>
      </div>
    </div>
  </div>

  <!-- Back to top button -->
  <button
    id="back-to-top"
    class="fixed bottom-8 right-8 w-14 h-14 bg-gradient-to-r from-kosovo-gold to-kosovo-gold-dark text-white rounded-2xl shadow-lg shadow-kosovo-gold/30 flex items-center justify-center opacity-0 invisible transition-all duration-300 z-50 hover:scale-110"
    aria-label="Back to top"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
  </button>
</footer>

<script>
  // Newsletter form
  const newsletterForm = document.getElementById('newsletter-form');
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = newsletterForm.querySelector('button');
      const originalContent = btn?.innerHTML;

      if (btn) {
        btn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
        btn.disabled = true;
      }

      setTimeout(() => {
        if (btn) {
          btn.innerHTML = '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>';
        }
        setTimeout(() => {
          if (btn && originalContent) {
            btn.innerHTML = originalContent;
            btn.disabled = false;
          }
          const input = newsletterForm.querySelector('input');
          if (input) input.value = '';
        }, 2000);
      }, 1500);
    });
  }

  // Back to top button
  const backToTop = document.getElementById('back-to-top');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 500) {
      backToTop?.classList.remove('opacity-0', 'invisible');
      backToTop?.classList.add('opacity-100', 'visible');
    } else {
      backToTop?.classList.add('opacity-0', 'invisible');
      backToTop?.classList.remove('opacity-100', 'visible');
    }
  });

  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
