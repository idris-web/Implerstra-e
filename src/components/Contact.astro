---
import { translations } from '../i18n/translations';

interface Props {
  lang: keyof typeof translations;
}

const { lang } = Astro.props;
const t = translations[lang];

// Placeholder contact info - to be filled in
const contactInfo = {
  address: 'Musterstraße 123, 80333 München',
  phone: '+49 89 12345678',
  email: 'info@kosova-muenchen.de',
};
---

<section id="contact" class="py-20 md:py-32 bg-white relative overflow-hidden">
  <!-- Decorative -->
  <div class="absolute top-0 left-0 w-64 h-64 bg-kosovo-blue/5 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-2 bg-kosovo-blue/10 text-kosovo-blue text-sm font-semibold rounded-full mb-4">
        📍 {t.contact.subtitle}
      </span>
      <h2 class="section-title">{t.contact.title}</h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div class="space-y-6">
        <!-- Address -->
        <div class="card flex items-start gap-5">
          <div class="w-14 h-14 bg-kosovo-blue/10 rounded-2xl flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-kosovo-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">{t.contact.address}</h3>
            <p class="text-gray-600">{contactInfo.address}</p>
          </div>
        </div>

        <!-- Phone -->
        <div class="card flex items-start gap-5">
          <div class="w-14 h-14 bg-kosovo-gold/10 rounded-2xl flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-kosovo-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">{t.contact.phone}</h3>
            <a href={`tel:${contactInfo.phone.replace(/\s/g, '')}`} class="text-kosovo-blue hover:underline">
              {contactInfo.phone}
            </a>
          </div>
        </div>

        <!-- Email -->
        <div class="card flex items-start gap-5">
          <div class="w-14 h-14 bg-green-100 rounded-2xl flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">{t.contact.email}</h3>
            <a href={`mailto:${contactInfo.email}`} class="text-kosovo-blue hover:underline">
              {contactInfo.email}
            </a>
          </div>
        </div>

        <!-- Hours -->
        <div class="card flex items-start gap-5 bg-gradient-to-r from-kosovo-blue/5 to-transparent">
          <div class="w-14 h-14 bg-kosovo-blue rounded-2xl flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-1">{t.contact.hours}</h3>
            <p class="text-gray-600">{t.contact.hoursText}</p>
          </div>
        </div>
      </div>

      <!-- Map Placeholder -->
      <div class="relative">
        <div class="aspect-square lg:aspect-auto lg:h-full min-h-[400px] bg-gradient-to-br from-kosovo-blue/10 to-kosovo-gold/10 rounded-3xl overflow-hidden border-2 border-kosovo-blue/20">
          <!-- Map placeholder -->
          <div class="w-full h-full flex items-center justify-center">
            <div class="text-center p-8">
              <div class="w-20 h-20 mx-auto bg-kosovo-blue/10 rounded-full flex items-center justify-center mb-4">
                <svg class="w-10 h-10 text-kosovo-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                </svg>
              </div>
              <p class="text-gray-600 mb-4">
                {lang === 'de' ? 'Google Maps wird hier eingebettet' : lang === 'sq' ? 'Google Maps do të vendoset këtu' : 'سيتم تضمين خرائط جوجل هنا'}
              </p>
              <a
                href="https://maps.google.com"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 btn-secondary text-sm"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
                {lang === 'de' ? 'In Google Maps öffnen' : lang === 'sq' ? 'Hap në Google Maps' : 'افتح في خرائط جوجل'}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
