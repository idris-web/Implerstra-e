---
import { translations, type languages } from '../i18n/translations';

interface Props {
  lang: keyof typeof translations;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;
const t = translations[lang];

const navItems = [
  { href: '#home', label: t.nav.home },
  { href: '#about', label: t.nav.about },
  { href: '#prayer-times', label: t.nav.prayerTimes },
  { href: '#events', label: t.nav.events },
  { href: '#gallery', label: t.nav.gallery },
  { href: '#team', label: t.nav.team },
  { href: '#contact', label: t.nav.contact },
];

const langLinks = [
  { code: 'de', label: 'DE', href: '/' },
  { code: 'sq', label: 'SQ', href: '/sq/' },
  { code: 'ar', label: 'ع', href: '/ar/' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md shadow-md transition-all duration-300" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="#home" class="flex items-center gap-3 group">
        <div class="w-12 h-12 bg-gradient-to-br from-kosovo-blue to-kosovo-blue-dark rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
          <span class="text-white font-bold text-xl">K</span>
        </div>
        <div class="hidden sm:block">
          <span class="text-kosovo-blue font-bold text-lg">Kosova e.V.</span>
          <span class="block text-xs text-gray-500">München</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-4 py-2 text-gray-700 hover:text-kosovo-blue font-medium rounded-lg hover:bg-kosovo-blue/5 transition-all duration-200"
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Right side: Language Switcher + CTA + Mobile Menu -->
      <div class="flex items-center gap-4">
        <!-- Language Switcher -->
        <div class="flex items-center gap-1 bg-gray-100 rounded-lg p-1">
          {langLinks.map((langLink) => (
            <a
              href={langLink.href}
              class={`px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${
                lang === langLink.code
                  ? 'bg-kosovo-blue text-white shadow-md'
                  : 'text-gray-600 hover:text-kosovo-blue hover:bg-white'
              }`}
            >
              {langLink.label}
            </a>
          ))}
        </div>

        <!-- CTA Button (Desktop) -->
        <a href="#donate" class="hidden md:inline-flex btn-primary text-sm py-2 px-5">
          {t.nav.donate}
        </a>

        <!-- Mobile Menu Button -->
        <button
          class="lg:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors"
          id="mobile-menu-button"
          aria-label="Menu"
        >
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" id="menu-icon-open"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" id="menu-icon-close" class="hidden"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="lg:hidden hidden bg-white border-t shadow-lg" id="mobile-menu">
    <div class="px-4 py-4 space-y-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block px-4 py-3 text-gray-700 hover:text-kosovo-blue font-medium rounded-lg hover:bg-kosovo-blue/5 transition-all duration-200"
        >
          {item.label}
        </a>
      ))}
      <a href="#donate" class="block btn-primary text-center mt-4">
        {t.nav.donate}
      </a>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    menuIconOpen?.classList.toggle('hidden');
    menuIconClose?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking a link
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
    });
  });

  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('shadow-lg', 'bg-white');
      navbar?.classList.remove('bg-white/95');
    } else {
      navbar?.classList.remove('shadow-lg', 'bg-white');
      navbar?.classList.add('bg-white/95');
    }
  });
</script>
